# Agent working directories — one git worktree per ticket while it is in flight
.claude/

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/
next-env.d.ts

# Prisma — generated client is produced by `prisma generate`, never committed
src/generated/

# Environment
.env
.env.local
.env.*.local

# Local object storage (development photo uploads)
.storage/

# Testing
coverage/
playwright-report/
test-results/
.playwright/
# Per-session page snapshots written into the working copy by the Playwright
# MCP browser tooling. Scratch output that carries whatever page was open at
# the time, and nothing here may depend on it.
.playwright-mcp/

# Vercel
.vercel

# Editor and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
