# ---------------------------------------------------------------------------
# Database
#
# Development: a local PostgreSQL 17 instance. DATABASE_URL and DIRECT_URL are
# the same string, because there is no pooler in front of a local database.
#
# Deployment (Supabase): the two differ, and the difference matters.
#   DATABASE_URL — transaction pooler, port 6543, with pgbouncer=true because
#                  prepared statements are unsupported in transaction mode, and
#                  connection_limit=1 because every serverless invocation is new:
#     postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL   — session mode, port 5432. Migrations must NOT go through the
#                  transaction pooler:
#     postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://inventaris:CHANGE_ME@localhost:5432/inventaris_aset_ppm?schema=public"
DIRECT_URL="postgresql://inventaris:CHANGE_ME@localhost:5432/inventaris_aset_ppm?schema=public"

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Absolute base URL of this deployment.
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute base URL used to build the QR payload. A QR code is printed on a
# physical label, so this must be the final production URL before any label is
# printed for real use — otherwise every printed label is dead.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Object storage — Supabase Storage in every environment (src/lib/storage.ts)
#
# There is no local-filesystem driver and no STORAGE_DRIVER switch; see ADR
# 0005. All three variables below are REQUIRED in development as well as in
# deployment — photo upload does not work without them, and does not work
# offline.
#
# One Supabase project holds both buckets. Only the bucket name differs
# between environments.
# ---------------------------------------------------------------------------
SUPABASE_URL=""

# Server-side only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
# This key bypasses row-level security: it is what mints signed upload URLs
# after the Better Auth session has been checked.
SUPABASE_SERVICE_ROLE_KEY=""

# "asset-photos-dev" in development, "asset-photos" in deployment.
SUPABASE_STORAGE_BUCKET="asset-photos-dev"
