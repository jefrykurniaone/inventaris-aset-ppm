# Neon Postgres — pooled connection, used by the application at runtime through
# @prisma/adapter-neon. Take the "Pooled connection" string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres — direct connection, used by `prisma migrate`. Migrations must not go through
# the pooler.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth — session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Better Auth — absolute base URL of this deployment.
BETTER_AUTH_URL="http://localhost:3000"

# Absolute base URL used to build the QR payload. A QR code is printed on a physical label, so
# this must be the public production URL before any label is printed for real.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob — read/write token for photo storage.
BLOB_READ_WRITE_TOKEN=""
