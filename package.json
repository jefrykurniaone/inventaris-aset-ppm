{
  "name": "inventaris-aset-ppm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "auth:generate": "npx --no auth generate --adapter prisma --yes --output prisma/models/auth.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:e2e-master-data": "tsx scripts/seed-e2e-master-data.ts",
    "check:encoding": "git ls-files -z | tsx scripts/check-encoding.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.1",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "nanoid": "^6.0.2",
    "next": "15.5.28",
    "next-intl": "^4.14.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "auth": "1.7.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
