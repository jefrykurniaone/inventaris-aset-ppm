{
  "name": "inventaris-aset-ppm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "auth:generate": "npx --no auth generate --adapter prisma --yes --output prisma/models/auth.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:e2e-master-data": "tsx scripts/seed-e2e-master-data.ts",
    "storage:purge:dev": "tsx scripts/purge-dev-storage-bucket.ts",
    "check:encoding": "git ls-files -z | tsx scripts/check-encoding.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@supabase/supabase-js": "^2.112.3",
    "better-auth": "1.7.1",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "nanoid": "^6.0.1",
    "next": "15.5.23",
    "next-intl": "^4.13.7",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0",
    "uqr": "0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "auth": "1.7.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prisma": "7.9.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
