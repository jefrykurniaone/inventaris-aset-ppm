// Prisma 7 schema.
//
// The datasource carries no `url`: the connection string lives in
// `prisma.config.ts` for the CLI, and in `src/lib/db.ts` — through the
// `@prisma/adapter-pg` driver adapter — for the runtime client.
//
// `User`, `Session`, `Account` and `Verification` are generated by the Better
// Auth CLI and are never edited by hand. The single exception is the four
// reverse relation fields on `User`, which exist only because the application
// models point at it; they carry no authentication state.
//
// Naming follows the auth models: PascalCase model, snake_case table through
// `@@map`, camelCase columns.
//
// Enum members are spelled exactly as `docs/prd.md` spells them and carry no
// `@map`. In Prisma 7 a mapped enum member emits the mapped value into the
// generated TypeScript object while the query engine still expects the schema
// name, so a `@map` here would be a runtime trap. Enum type names are mapped,
// so the PostgreSQL types follow the snake_case table naming.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  // Reverse sides of the application relations. Relation fields only.
  createdAssets  Asset[]
  uploadedPhotos AssetPhoto[]
  handledLoans   Loan[]
  activities     AssetActivity[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Fixed enumerations, not editable master data: application logic branches on
// them (FR-3.5, FR-8.1).

enum AssetStatus {
  active
  in_repair
  loaned
  retired
  lost

  @@map("asset_status")
}

enum AssetCondition {
  good
  fair
  poor

  @@map("asset_condition")
}

enum ActivityType {
  created
  updated
  status_changed
  photo_added
  photo_removed
  loaned
  returned
  deleted

  @@map("activity_type")
}

// Master data (FR-3.1). Every relation from `Asset` into these tables is
// `Restrict`: a record an asset references cannot be deleted, only deactivated
// through `isActive` (FR-3.4).

model Category {
  id        String   @id @default(uuid(7))
  code      String   @unique
  name      String
  nameEn    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]

  @@map("category")
}

model Building {
  id       String  @id @default(uuid(7))
  code     String  @unique
  name     String
  isActive Boolean @default(true)
  rooms    Room[]

  @@map("building")
}

model Room {
  id         String   @id @default(uuid(7))
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  code       String
  name       String
  isActive   Boolean  @default(true)
  assets     Asset[]

  // Room codes repeat between buildings, so uniqueness is per building. The
  // composite index also serves as the index on the foreign key.
  @@unique([buildingId, code])
  @@map("room")
}

model FundingSource {
  id       String  @id @default(uuid(7))
  name     String  @unique
  notes    String?
  isActive Boolean @default(true)
  assets   Asset[]

  @@map("funding_source")
}

// The register itself. Deletion is a soft delete (FR-2.5): `deletedAt` is set
// and the row stays, so a printed label never becomes a dead end. Field order
// and spelling follow the visibility table in `docs/prd.md` §8.2, which the
// data-fetch layer reads to decide what a public query may select.
model Asset {
  id String @id @default(uuid(7))

  // PUBLIC — rendered on an anonymous scan.
  assetCode           String         @unique
  name                String
  categoryId          String
  category            Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  photos              AssetPhoto[]
  condition           AssetCondition
  status              AssetStatus    @default(active)
  roomId              String
  room                Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  brand               String?
  model               String?
  serialNumber        String?
  universityAssetCode String?
  acquisitionYear     Int
  notes               String?
  qrToken             String         @unique

  // RESTRICTED — a session is required. `purchasePrice` is a fixed-point
  // decimal because it is money; IDR carries no subunit in practice, but the
  // scale is kept so a rounded value is never silently stored as an integer.
  purchasePrice    Decimal?       @db.Decimal(14, 2)
  fundingSourceId  String?
  fundingSource    FundingSource? @relation(fields: [fundingSourceId], references: [id], onDelete: Restrict)
  procurementDocNo String?
  vendor           String?
  warrantyUntil    DateTime?
  custodianName    String?
  custodianEmail   String?
  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  loans      Loan[]
  activities AssetActivity[]

  // Filters and sorts of the asset list query (FR-2.6). `assetCode` and
  // `qrToken` are already indexed by their unique constraints.
  @@index([categoryId])
  @@index([roomId])
  @@index([status])
  @@index([condition])
  @@index([acquisitionYear])
  @@index([fundingSourceId])
  @@index([deletedAt])
  @@index([createdById])
  @@map("asset")
}

// Up to five photos per asset, exactly one primary (FR-4.1). `url` and
// `thumbUrl` hold the storage object path, never an absolute URL (FR-4.9); the
// URL is built at render time from the configured bucket.
//
// At most one primary photo per asset is enforced by a partial unique index on
// `("assetId") WHERE "isPrimary"`, declared below and created by the migration.
model AssetPhoto {
  id           String   @id @default(uuid(7))
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  url          String
  thumbUrl     String
  width        Int
  height       Int
  sizeBytes    Int
  isPrimary    Boolean  @default(false)
  sortOrder    Int      @default(0)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([assetId, sortOrder])
  @@index([uploadedById])
  @@map("asset_photo")
}

// Loan and return records (FR-7.1).
model Loan {
  id            String    @id @default(uuid(7))
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  borrowerName  String
  borrowerEmail String
  borrowerUnit  String
  checkedOutAt  DateTime  @default(now())
  dueAt         DateTime
  returnedAt    DateTime?
  notes         String?
  handledById   String
  handledBy     User      @relation(fields: [handledById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([assetId])
  @@index([handledById])
  @@index([dueAt])
  @@map("loan")
}

// Append-only audit trail (FR-8.3). Rows are never updated or deleted by the
// application, so the model carries no `updatedAt`.
model AssetActivity {
  id        String       @id @default(uuid(7))
  assetId   String
  asset     Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  type      ActivityType
  payload   Json
  createdAt DateTime     @default(now())

  @@index([assetId, createdAt])
  @@index([actorId])
  @@map("asset_activity")
}
