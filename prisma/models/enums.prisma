// Fixed enumerations, not editable master data: logic branches on them, so a
// new member is a code change rather than a row (FR-3.5). Anything an
// administrator may add or rename at runtime belongs in `master-data.prisma`
// instead.
//
// No member carries an `@map`. In Prisma 7 a mapped enum member emits the
// *mapped* value into the generated TypeScript union while the query engine
// still expects the schema-side name, so a mapped member type-checks and then
// fails at runtime. The member names are therefore already the database
// values, spelled snake_case to match the `@@map`ped enum type names.

enum AssetStatus {
  active
  in_repair
  loaned
  retired
  lost

  @@map("asset_status")
}

enum AssetCondition {
  good
  fair
  poor

  @@map("asset_condition")
}

enum ActivityType {
  created
  updated
  status_changed
  photo_added
  photo_removed
  loaned
  returned
  deleted

  @@map("activity_type")
}

// The two halves of a user account's deactivation history (issue #86). Kept
// apart from `ActivityType` on purpose: that enum belongs to `AssetActivity`,
// whose every row must hang off a real asset, and widening it would mean
// loosening that model's `assetId` invariant for rows that are not about
// assets. `UserActivity` is its own table instead, so this is its own enum.

enum UserActivityType {
  deactivated
  reactivated

  @@map("user_activity_type")
}

// The outcome of one `/sign-in/email` attempt (issue #112). Three members and
// not two, because only one of them may move an address towards a lock:
//
//   `failed`    — credentials rejected. Counts towards the threshold.
//   `succeeded` — a session was created. Breaks the consecutive-failure streak.
//   `blocked`   — refused because the lock was already in force. Recorded so an
//                 ongoing campaign stays visible, and deliberately *not*
//                 counted: if a refused attempt extended the lock, an attacker
//                 could hold a known address locked for as long as they cared
//                 to keep sending requests, which is exactly the
//                 denial-of-service lever a temporary lock exists to avoid.

enum SignInAttemptOutcome {
  succeeded
  failed
  blocked

  @@map("sign_in_attempt_outcome")
}
